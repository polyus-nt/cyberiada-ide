<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key attr.name="name" attr.type="string" for="node" id="dName"></key>
  <key attr.name="data" attr.type="string" for="node" id="dData"></key>
  <key attr.name="data" attr.type="string" for="edge" id="dData"></key>
  <key attr.name="initial" attr.type="string" for="node" id="dInitial"></key>
  <key for="edge" id="dGeometry"></key>
  <key for="node" id="dGeometry"></key>
  <key for="edge" id="dColor"></key>
  <key for="node" id="dNote"></key>
  <key for="node" id="dColor"></key>
  <graph id="CyBear1">
    <data key="dStateMachine"></data>
    <data key="dGeometry">
      <rect x="0" y="0" width="450" height="100"></rect>
    </data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true

platform/ blg-mb-junior

</data>
    </node>
    <node id="okflwlkfywvbfboxvtnz">
      <data key="dName">Горят</data>
      <data key="dData">entry/
Eyes1.setColorPalette(&amp;ColorCyan);
Eyes2.setColorPalette(&amp;ColorCyan);
Timer1.start(500);

</data>
      <data key="dGeometry">
        <rect x="292.01434326171875" y="429.0013008117676" width="450" height="95"></rect>
      </data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="kocyhvlqsciswfwtqgil">
      <data key="dName">Погасли</data>
      <data key="dData">entry/
Eyes1.off();
Eyes2.off();
Timer1.start(500);

</data>
      <data key="dGeometry">
        <rect x="312.01434326171875" y="716.0013008117676" width="450" height="95"></rect>
      </data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="lyziztcjdoajczlbykxk">
      <data key="dVertex">initial</data>
      <data key="dGeometry">
        <point x="-20.98565673828125" y="445.0013008117676"></point>
      </data>
    </node>
    <node id="cEyes1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ Eyes1

type/ Eyes

pin/ 2

name/ Левый глаз

</data>
      <data key="dLapkiSchemePosition">
        <point x="30" y="30"></point>
      </data>
    </node>
    <node id="cEyes2">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ Eyes2

type/ Eyes

pin/ 1

name/ Правый глаз

</data>
      <data key="dLapkiSchemePosition">
        <point x="30" y="30"></point>
      </data>
    </node>
    <node id="cTimer1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ Timer1

type/ Timer

name/ Таймер

</data>
      <data key="dLapkiSchemePosition">
        <point x="30" y="30"></point>
      </data>
    </node>
    <edge id="miskycbgivlijsbmctdh" source="lyziztcjdoajczlbykxk" target="okflwlkfywvbfboxvtnz"></edge>
    <edge id="vbfvxkqjsjuajvckkesc" source="okflwlkfywvbfboxvtnz" target="kocyhvlqsciswfwtqgil">
      <data key="dData">Timer1.timeout/

</data>
      <data key="dLabelGeometry">
        <point x="136.51434326171875" y="530.0013008117676"></point>
      </data>
    </edge>
    <edge id="ooffzxcvvtpeqqlajloe" source="kocyhvlqsciswfwtqgil" target="okflwlkfywvbfboxvtnz">
      <data key="dData">Timer1.timeout/

</data>
      <data key="dLabelGeometry">
        <point x="794.5143432617188" y="598.5013008117676"></point>
      </data>
    </edge>
  </graph>
</graphml>
