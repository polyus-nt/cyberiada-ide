      <rect x="0" y="0" width="450" height="100"></rect>
    </data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true

platform/ blg-mb-junior

</data>
    </node>
    <node id="lzjudgplmsjgjmtmvqwx">
      <data key="dName">Праздник</data>
      <data key="dData">entry/
Timer1.start(500);

Timer1.timeout/
Random1.doRangeRandom(0, 256);
Random2.doRangeRandom(0, 256);
Random3.doRangeRandom(0, 256);
Random4.doRangeRandom(0, 256);
Eyes1.setColor(Random1.value, Random2.value, Random3.value, Random4.value);
Eyes2.setColor(Random1.value, Random2.value, Random3.value, Random4.value);
Timer1.start(500);

</data>
      <data key="dGeometry">
        <rect x="100" y="100" width="450" height="95"></rect>
      </data>
    </node>
    <node id="lvtslvngpqqcifcpxiny">
