<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <data key="gFormat">Cyberiada-GraphML-1.0</data>
  <key attr.name="name" attr.type="string" for="node" id="dName"></key>
  <key attr.name="data" attr.type="string" for="node" id="dData"></key>
  <key attr.name="data" attr.type="string" for="edge" id="dData"></key>
  <key attr.name="initial" attr.type="string" for="node" id="dInitial"></key>
  <key for="edge" id="dGeometry"></key>
  <key for="node" id="dGeometry"></key>
  <key for="edge" id="dColor"></key>
  <key for="node" id="dNote"></key>
  <key for="node" id="dColor"></key>
  <graph id="CyBear1">
    <data key="dStateMachine"></data>
    <data key="dGeometry">
      <rect x="0" y="0" width="450" height="100"></rect>
    </data>
    <node id="coreMeta">
      <data key="dNote">formal</data>
      <data key="dName">CGML_META</data>
      <data key="dData">standardVersion/ 1.0

platformVersion/ 1.0

lapkiVisual/ true

platform/ blg-mb-junior

</data>
    </node>
    <node id="obuslbfuvazudcyxooue">
      <data key="dName">Настроение</data>
      <data key="dData">entry/
Timer1.start(2000);

Timer1.timeout/
Random1.doRangeRandom(1, 5);
UserSignal1.call();
Timer1.start(2000);

UserSignal1.isCalled[Random1.value == 1]/
MatrixPicture1.draw(heart);

UserSignal1.isCalled[Random1.value == 2]/
MatrixPicture1.draw(smile);

UserSignal1.isCalled[Random1.value == 3]/
MatrixPicture1.draw(sadness);

UserSignal1.isCalled[Random1.value == 4]/
MatrixPicture1.draw(question);

</data>
      <data key="dGeometry">
        <rect x="307.40717163085947" y="142.9006504058838" width="450" height="95"></rect>
      </data>
      <data key="dColor">#FFFFFF</data>
    </node>
    <node id="odjxamzffnwfnefythgl">
      <data key="dVertex">initial</data>
      <data key="dGeometry">
        <point x="-49.992828369140625" y="139.5006504058838"></point>
      </data>
    </node>
    <node id="cMatrixPicture1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ MatrixPicture1

type/ MatrixPicture

name/ Матрица

</data>
      <data key="dLapkiSchemePosition">
        <point x="30" y="30"></point>
      </data>
    </node>
    <node id="cRandom1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ Random1

type/ Random

name/ Генератор

</data>
      <data key="dLapkiSchemePosition">
        <point x="30" y="30"></point>
      </data>
    </node>
    <node id="cUserSignal1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ UserSignal1

type/ UserSignal

name/ Своё событие

</data>
      <data key="dLapkiSchemePosition">
        <point x="30" y="30"></point>
      </data>
    </node>
    <node id="cTimer1">
      <data key="dNote">formal</data>
      <data key="dName">CGML_COMPONENT</data>
      <data key="dData">id/ Timer1

type/ Timer

name/ Таймер

</data>
      <data key="dLapkiSchemePosition">
        <point x="30" y="30"></point>
      </data>
    </node>
    <edge id="sjpyhtllhzlsoxfuenjh" source="odjxamzffnwfnefythgl" target="obuslbfuvazudcyxooue"></edge>
  </graph>
</graphml>
