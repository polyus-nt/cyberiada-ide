    <node id="hlmegwbcehzqgmuaopom">
      <data key="dName">Короткая 1</data>
      <data key="dData">entry/
Eyes1.setColorPalette(&amp;ColorCyan);
Eyes2.setColorPalette(&amp;ColorCyan);
Timer1.start(500);

</data>
      <data key="dGeometry">
        <rect x="100" y="100" width="450" height="95"></rect>
      </data>
    </node>
    <node id="psgmcphyawiqnpmxdvid">
      <data key="dName">Пауза 1</data>
      <data key="dData">entry/
