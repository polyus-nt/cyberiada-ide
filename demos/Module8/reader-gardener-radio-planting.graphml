platform/ junior-gardener

</data>
    </node>
    <node id="mxmnmvpwonbnadcchfub">
      <data key="dName">Работа</data>
      <data key="dData">Receiver1.impulse_received[Receiver1.received_impulse == Receiver1.impulseA]/
Flower1.plant(1)
Mover1.move_forward()

Receiver1.impulse_received[Receiver1.received_impulse == Receiver1.impulseB]/
Flower1.plant(2)
Mover1.move_forward()

Receiver1.impulse_received[Receiver1.received_impulse == Receiver1.impulseC]/
Flower1.plant(3)
Mover1.move_forward()

</data>
      <data key="dGeometry">
        <rect x="187.00717163085938" y="507.5006504058838" width="450" height="95"></rect>
      </data>
