    <node id="dbmeopsgehiuswansxme">
      <data key="dName">Чтение</data>
      <data key="dData">entry/
Reader1.read()

Reader1.char_accepted[Reader1.current_char == А]/
Impulse1.impulseA()
Reader1.read()

Reader1.char_accepted[Reader1.current_char == Б]/
Impulse1.impulseB()
Reader1.read()

Reader1.char_accepted[Reader1.current_char == В]/
Impulse1.impulseC()
Reader1.read()

</data>
      <data key="dGeometry">
        <rect x="187.00717163085938" y="507.5006504058838" width="450" height="95"></rect>
      </data>
    </node>
