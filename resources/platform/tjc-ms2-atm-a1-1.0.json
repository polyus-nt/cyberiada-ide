        }
      },
      "variables": {
        "temperature": {
          "description": "Температура в сотых долях °C: 2350 означает 23,50 °C.",
          "type": "int32_t",
          "img": "ms2-atm/temperature.svg",
          "alias": "Температура"
        },
        "pressure": {
          "description": "Давление в сотых долях Па: 10132500 означает 101325 Па.",
          "type": "int32_t",
          "img": "ms2-atm/gauge-pressure.svg",
