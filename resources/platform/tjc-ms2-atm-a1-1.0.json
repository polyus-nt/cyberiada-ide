{
  "name": "МС-ТЮК-2: Атмосферная плата A1",
  "id": "tjc-ms2-atm-a1",
  "description": "Программирование M2 STM32G030K8. Пять датчиков S2–S6.",
  "version": "1.0",
  "standardVersion": "1.0",
  "formatVersion": "1.0",
  "language": "C++",
  "author": "Lapki TEAM",
  "icon": "ms2-atm/board-a1.svg",
  "staticComponents": false,
  "visual": true,
  "compile": true,
  "mainFileExtension": "cpp",
  "headerFileExtension": "hpp",
  "mainFunction": true,
  "delimeter": ";",
  "defaultSetupFunctions": [],
  "defaultIncludeFiles": ["AtmRuntime.hpp"],
  "defaultBuildFiles": [
    "Board.hpp",
    "AtmRuntime.hpp",
    "AtmRuntime.cpp",
    "stm32g030k8.ld",
    "startup_stm32g030xx.s",
    "stm32g030xx.h",
    "core_cm0plus.h",
    "core_cmInstr.h",
    "cmsis_gcc.h",
    "core_cmFunc.h",
    "system_stm32g0xx.h"
  ],
  "compilingSettings": [
    {
      "command": "arm-none-eabi-g++",
      "flags": [
        "-std=c++11",
        "-mcpu=cortex-m0plus",
        "-mthumb",
        "-DSTM32G030x8",
        "-T",
        "./stm32g030k8.ld",
        "./startup_stm32g030xx.s",
        "./sketch.cpp",
        "./AtmRuntime.cpp",
        "qhsm.cpp",
        "-o",
        "./build/sketch.elf",
        "--specs=nosys.specs",
        "-Os",
        "-g",
        "-fno-exceptions",
        "-fno-rtti",
        "-fno-threadsafe-statics",
        "-ffunction-sections",
        "-fdata-sections",
        "-Wl,--gc-sections",
        "-Wl,-Map=./build/sketch.map"
      ]
    },
    {
      "command": "arm-none-eabi-objcopy",
      "flags": ["-Obinary", "./build/sketch.elf", "./build/sketch.bin"]
    }
  ],
  "components": {
    "SimpleBus": {
      "description": "Компонент для базового взаимодействия с общей шиной данных на основе простого протокола. Шина является полудуплексной – отправку в конкретный момент времени может осуществлять только один участник. Использует USART1 (PB6/PB7), управление передачей PA0. SimpleBus и DataBus взаимоисключающие; используйте один экземпляр выбранного типа.",
      "img": "tjc-ms/busSimple.svg",
      "signals": {
        "packetReceived": {
          "img": "tjc-ms/packetReceived.svg",
          "description": "Получен адресованный пакет.",
          "checkMethod": "packetReceived",
          "alias": "Получено сообщение"
        }
      },
      "constructorParameters": {},
      "variables": {
        "myAddress": {
          "img": "tjc-ms/addr.svg",
          "type": "uint8_t",
          "description": "Адрес устройства.",
          "alias": "Адрес"
        },
        "lastData": {
          "img": "tjc-ms/lastData.svg",
          "type": "uint8_t",
          "description": "Последний полученный символ.",
          "alias": "Последний символ"
        }
      },
      "methods": {
        "setAddress": {
          "img": "tjc-ms/addrSet.svg",
          "parameters": [
            {
              "name": "address",
              "type": "byte",
              "description": "Новое значение для адреса."
            }
          ],
          "description": "Назначить новый адрес для получения пакетов.",
          "alias": "Установить адрес"
        },
        "sendPacket": {
          "img": "tjc-ms/sendPacket.svg",
          "parameters": [
            {
              "name": "address",
              "type": "byte",
              "description": "Адрес устройства-получателя."
            },
            {
              "name": "data",
              "type": "byte",
              "description": "Байт данных (сообщение)."
            }
          ],
          "description": "Отправляет символ по адресу.",
          "alias": "Отправить сообщение"
        }
      },
      "buildFiles": ["SimpleBus.hpp", "AtmUart.hpp"],
      "importFiles": ["SimpleBus.hpp"],
      "singletone": false,
      "name": "Простая шина",
      "initializationFunction": "begin"
    },
    "DataBus": {
      "description": "Компонент для низкоуровневого взаимодействия с общей шиной данных. Шина является полудуплексной – отправку в конкретный момент времени может отсуществлять только один участник. Использует USART1 (PB6/PB7), управление передачей PA0. SimpleBus и DataBus взаимоисключающие; используйте один экземпляр выбранного типа.",
      "img": "tjc-ms/bus.svg",
      "signals": {
        "isByteReceived": {
          "img": "arduino/byteReceived.svg",
          "description": "Получен байт.",
          "checkMethod": "isByteReceived",
          "alias": "Получен байт"
        }
      },
      "constructorParameters": {
        "baudrate": {
          "type": "uint32_t",
          "description": "Частота работы.",
          "optional": true
        }
      },
      "variables": {
        "lastByte": {
          "img": "tjc-ms/lastByte.svg",
          "type": "uint8_t",
          "description": "Последний полученный байт.",
          "alias": "Последний байт"
        }
      },
      "methods": {
        "sendByte": {
          "img": "tjc-ms/sendByte.svg",
          "parameters": [
            {
              "name": "data",
              "type": "byte",
              "description": "Байт данных (сообщение)."
            }
          ],
          "description": "Отправить байт в шину.",
          "alias": "Отправить байт"
        }
      },
      "buildFiles": ["DataBus.hpp", "AtmUart.hpp"],
      "importFiles": ["DataBus.hpp"],
      "singletone": false,
      "name": "Шина данных",
      "initializationFunction": "begin"
    },
    "RGBLed": {
      "name": "RGB-светодиод",
      "description": "Встроенный RGB-светодиод PA5/PA6/PA7. Один экземпляр. После запуска выключен.",
      "img": "ms2-atm/rgb-led.svg",
      "signals": {},
      "constructorParameters": {},
      "variables": {
        "red": {
          "description": "Яркость канала от 0 до 255. Меняйте через setColor.",
          "type": "uint8_t",
          "img": "ms2-atm/red.svg",
          "alias": "Красный"
        },
        "green": {
          "description": "Яркость канала от 0 до 255. Меняйте через setColor.",
          "type": "uint8_t",
          "img": "ms2-atm/green.svg",
          "alias": "Зелёный"
        },
        "blue": {
          "description": "Яркость канала от 0 до 255. Меняйте через setColor.",
          "type": "uint8_t",
          "img": "ms2-atm/blue.svg",
          "alias": "Синий"
        }
      },
      "methods": {
        "setColor": {
          "img": "ms2-atm/set-color.svg",
          "description": "Установить цвет",
          "parameters": [
            {
              "name": "red",
              "type": "uint8_t",
              "description": "Красный (0–255)",
              "img": "ms2-atm/red.svg"
            },
            {
              "name": "green",
              "type": "uint8_t",
              "description": "Зелёный (0–255)",
              "img": "ms2-atm/green.svg"
            },
            {
              "name": "blue",
              "type": "uint8_t",
              "description": "Синий (0–255)",
              "img": "ms2-atm/blue.svg"
            }
          ],
          "alias": "Установить цвет"
        },
        "off": {
          "img": "arduino/switch-off.svg",
          "description": "Выключить",
          "alias": "Выключить"
        }
      },
      "initializationFunction": "begin",
      "buildFiles": ["RGBLed.hpp"],
      "importFiles": ["RGBLed.hpp"],
      "singletone": false
    },
    "SCD41": {
      "name": "Датчик CO₂ (SCD41)",
      "description": "S3: CO₂ и температура, автоопрос. Новая выборка примерно раз в 5 секунд. Ошибка после 15 секунд без данных запускает восстановление; предыдущие значения сохраняются.",
      "img": "ms2-atm/co2.svg",
      "signals": {
        "valueReceived": {
          "img": "ms2-atm/value-received.svg",
          "description": "Получено значение",
          "alias": "Получено значение",
          "checkMethod": "valueReceived"
        },
        "readingError": {
          "img": "ms2-atm/read-error.svg",
          "description": "Ошибка чтения",
          "alias": "Ошибка чтения",
          "checkMethod": "readingError"
        }
      },
      "variables": {
        "temperature": {
          "description": "Температура в сотых долях °C: 2350 означает 23,50 °C.",
          "type": "int32_t",
          "img": "ms2-atm/temperature.svg",
          "alias": "Температура"
        },
        "co2": {
          "description": "Концентрация CO₂ в сотых долях ppm: 40000 означает 400 ppm.",
          "type": "int32_t",
          "img": "ms2-atm/co2.svg",
          "alias": "CO₂"
        },
        "error": {
          "description": "Последняя попытка чтения завершилась ошибкой. Успешное чтение сбрасывает флаг. До первого чтения — false.",
          "type": "bool",
          "img": "ms2-atm/read-error.svg",
          "alias": "Произошла ошибка"
        }
      },
      "methods": {},
      "constructorParameters": {},
      "initializationFunction": "begin",
      "loopActions": ["poll"],
      "buildFiles": ["AtmSensors.hpp", "AtmI2c.hpp", "SensorDrivers.hpp", "SensorMath.hpp"],
      "importFiles": ["AtmSensors.hpp"],
      "singletone": false
    },
    "HP203B": {
      "name": "Датчик давления (HP203B)",
      "description": "S2: давление и температура, автоопрос примерно раз в секунду. При ошибке предыдущая выборка сохраняется.",
      "img": "ms2-atm/barometer.svg",
      "signals": {
        "valueReceived": {
          "img": "ms2-atm/value-received.svg",
          "description": "Получено значение",
          "alias": "Получено значение",
          "checkMethod": "valueReceived"
        },
        "readingError": {
          "img": "ms2-atm/read-error.svg",
          "description": "Ошибка чтения",
          "alias": "Ошибка чтения",
          "checkMethod": "readingError"
        }
      },
      "variables": {
        "temperature": {
          "description": "Температура в сотых долях °C: 2350 означает 23,50 °C.",
          "type": "int32_t",
          "img": "ms2-atm/temperature.svg",
          "alias": "Температура"
        },
        "pressure": {
          "description": "Давление в сотых долях Па: 10132500 означает 101325 Па.",
          "type": "int32_t",
