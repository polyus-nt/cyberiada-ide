{
  "schemaVersion": 1,
  "id": "gardener-mint-abundance",
  "version": 1,
  "title": "Мятное изобилие",
  "summary": "Засейте всё свободное поле мятой, не трогая уже посаженные растения.",
  "codeWord": "ИЗОБИЛИЕ",
  "descriptionFile": "gardener-mint-abundance.md",
  "platformId": "junior-gardener",
  "tests": [
    {
      "id": "field-3x2",
      "title": "Поле 3×2",
      "timeoutSeconds": 10,
      "input": {
        "width": 3,
        "height": 2,
        "field": [
          [0, 1, 0],
          [0, 0, 3]
        ],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [
            [2, 1, 2],
            [2, 2, 3]
          ]
        }
      ]
    },
    {
      "id": "field-6x4",
      "title": "Поле 6×4",
      "timeoutSeconds": 10,
      "input": {
        "width": 6,
        "height": 4,
        "field": [
          [0, 0, 1, 0, 0, 0],
          [3, 0, 0, 0, 1, 0],
          [0, 0, 0, 3, 0, 0],
          [0, 1, 0, 0, 0, 0]
        ],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [
            [2, 2, 1, 2, 2, 2],
            [3, 2, 2, 2, 1, 2],
            [2, 2, 2, 3, 2, 2],
            [2, 1, 2, 2, 2, 2]
          ]
        }
      ]
    },
    {
      "id": "field-5x7",
      "title": "Поле 5×7",
      "timeoutSeconds": 10,
      "input": {
        "width": 5,
        "height": 7,
        "field": [
          [0, 0, 0, 1, 0],
          [0, 3, 0, 0, 0],
          [1, 0, 0, 0, 3],
          [0, 0, 1, 0, 0],
          [0, 3, 0, 0, 0],
          [0, 0, 0, 1, 0],
          [3, 0, 0, 0, 0]
        ],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [
            [2, 2, 2, 1, 2],
            [2, 3, 2, 2, 2],
            [1, 2, 2, 2, 3],
            [2, 2, 1, 2, 2],
            [2, 3, 2, 2, 2],
            [2, 2, 2, 1, 2],
            [3, 2, 2, 2, 2]
          ]
        }
      ]
    }
  ]
}
