{
  "schemaVersion": 1,
  "id": "gardener-running-late",
  "version": 1,
  "title": "Опаздывающий садовник",
  "summary": "Доберитесь до звездолёта, выполняя поручения встреченных цветов.",
  "codeWord": "СТАРТ",
  "descriptionFile": "gardener-running-late.md",
  "platformId": "junior-gardener",
  "tests": [
    {
      "id": "rose-order",
      "title": "Поручение розы",
      "input": {
        "width": 7,
        "height": 1,
        "field": [
          [0, 1, 0, 0, 0, 0, 0]
        ],
        "position": {
          "x": 0,
          "y": 0
        },
        "orientation": "EAST"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [
            [0, 1, 0, 0, 2, 0, 0]
          ]
        },
        {
          "type": "gardener.position.equals",
          "expected": {
            "x": 6,
            "y": 0
          }
        }
      ]
    },
    {
      "id": "cornflower-order",
      "title": "Поручение василька",
      "input": {
        "width": 7,
        "height": 1,
        "field": [
          [0, 0, 3, 0, 0, 0, 0]
        ],
        "position": {
          "x": 0,
          "y": 0
        },
        "orientation": "EAST"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [
            [0, 0, 3, 0, 2, 0, 0]
          ]
        },
        {
          "type": "gardener.position.equals",
          "expected": {
            "x": 6,
            "y": 0
          }
        }
      ]
    },
    {
      "id": "two-orders",
      "title": "Два поручения",
      "input": {
        "width": 12,
        "height": 1,
        "field": [
          [0, 1, 0, 0, 0, 0, 3, 0, 0, 0, 0, 0]
        ],
        "position": {
          "x": 0,
          "y": 0
        },
        "orientation": "EAST"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [
            [0, 1, 0, 0, 2, 0, 3, 0, 2, 0, 0, 0]
          ]
        },
        {
          "type": "gardener.position.equals",
          "expected": {
            "x": 11,
            "y": 0
          }
        }
      ]
    }
  ]
}
