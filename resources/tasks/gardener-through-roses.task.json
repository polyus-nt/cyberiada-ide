{
  "schemaVersion": 1,
  "id": "gardener-through-roses",
  "version": 1,
  "title": "Пробираясь сквозь розы",
  "summary": "Пройдите дорожку с севера на юг и посадите васильки во всех свободных клетках, сохранив розы.",
  "codeWord": "ТЕРНИИ",
  "descriptionFile": "gardener-through-roses.md",
  "platformId": "junior-gardener",
  "tests": [
    {
      "id": "single-empty-cell",
      "title": "Одна пустая клетка",
      "input": {
        "width": 1,
        "height": 1,
        "field": [[0]],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [[3]]
        },
        {
          "type": "gardener.position.equals",
          "expected": { "x": 0, "y": 0 }
        }
      ]
    },
    {
      "id": "single-rose-cell",
      "title": "Одна клетка с розой",
      "input": {
        "width": 1,
        "height": 1,
        "field": [[1]],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [[1]]
        },
        {
          "type": "gardener.position.equals",
          "expected": { "x": 0, "y": 0 }
        }
      ]
    },
    {
      "id": "empty-path",
      "title": "Пустая дорожка",
      "input": {
        "width": 1,
        "height": 4,
        "field": [[0], [0], [0], [0]],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [[3], [3], [3], [3]]
        },
        {
          "type": "gardener.position.equals",
          "expected": { "x": 0, "y": 3 }
        }
      ]
    },
    {
      "id": "rose-path",
      "title": "Дорожка из роз",
      "input": {
        "width": 1,
        "height": 5,
        "field": [[1], [1], [1], [1], [1]],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [[1], [1], [1], [1], [1]]
        },
        {
          "type": "gardener.position.equals",
          "expected": { "x": 0, "y": 4 }
        }
      ]
    },
    {
      "id": "roses-at-edges",
      "title": "Розы у обеих стен",
      "input": {
        "width": 1,
        "height": 7,
        "field": [[1], [0], [1], [1], [0], [0], [1]],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [[1], [3], [1], [1], [3], [3], [1]]
        },
        {
          "type": "gardener.position.equals",
          "expected": { "x": 0, "y": 6 }
        }
      ]
    },
    {
      "id": "empty-edges",
      "title": "Свободные клетки у обеих стен",
      "input": {
        "width": 1,
        "height": 8,
        "field": [[0], [1], [0], [0], [1], [1], [0], [0]],
        "position": { "x": 0, "y": 0 },
        "orientation": "SOUTH"
      },
      "checks": [
        {
          "type": "gardener.field.equals",
          "expected": [[3], [1], [3], [3], [1], [1], [3], [3]]
        },
        {
          "type": "gardener.position.equals",
          "expected": { "x": 0, "y": 7 }
        }
      ]
    }
  ]
}
