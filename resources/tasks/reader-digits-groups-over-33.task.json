{
  "schemaVersion": 1,
  "id": "reader-digits-groups-over-33",
  "version": 1,
  "title": "Строчник и числа",
  "summary": "Складывайте цифры в группах, разделённых дефисами, и подавайте импульс А, если сумма больше 33.",
  "codeWord": "ПОРОГ",
  "descriptionFile": "reader-digits-groups-over-33.md",
  "platformId": "junior-reader",
  "tests": [
    {
      "id": "statement-signal",
      "title": "Пример: превышение суммы",
      "timeoutSeconds": 10,
      "input": { "message": "5-9999" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseA"]
        }
      ]
    },
    {
      "id": "statement-no-signal",
      "title": "Пример: малые суммы",
      "timeoutSeconds": 10,
      "input": { "message": "10-20-4" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": []
        }
      ]
    },
    {
      "id": "one-signal-per-group",
      "title": "Один импульс для группы",
      "timeoutSeconds": 10,
      "input": { "message": "99999" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseA"]
        }
      ]
    },
    {
      "id": "reset-after-hyphen",
      "title": "Сброс после дефиса",
      "timeoutSeconds": 10,
      "input": { "message": "9999-9999" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseA", "impulseA"]
        }
      ]
    },
    {
      "id": "crosses-threshold",
      "title": "Превышение в конце группы",
      "timeoutSeconds": 10,
      "input": { "message": "9876-999" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseA"]
        }
      ]
    }
  ]
}
