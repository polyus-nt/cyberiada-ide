{
  "schemaVersion": 1,
  "id": "reader-gardener-radio-planting",
  "version": 2,
  "title": "Посадка по радио",
  "summary": "Передайте посадочный план из радиорубки в оранжерею.",
  "descriptionFile": "reader-gardener-radio-planting.md",
  "platformId": "reader-gardener",
  "tests": [
    {
      "id": "example",
      "title": "Пример: АБВВБА",
      "input": {
        "reader": {
          "message": "АБВВБА"
        },
        "gardener": {
          "width": 7,
          "height": 1,
          "field": [
            [
              0,
              0,
              0,
              0,
              0,
              0,
              0
            ]
          ],
          "position": {
            "x": 0,
            "y": 0
          },
          "orientation": "EAST"
        }
      },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": [
            "impulseA",
            "impulseB",
            "impulseC",
            "impulseC",
            "impulseB",
            "impulseA"
          ]
        },
        {
          "type": "gardener.field.equals",
          "expected": [
            [
              1,
              2,
              3,
              3,
              2,
              1,
              0
            ]
          ]
        },
        {
          "type": "gardener.position.equals",
          "expected": {
            "x": 6,
            "y": 0
          }
        }
      ]
    },
    {
      "id": "reverse",
      "title": "Другой порядок",
