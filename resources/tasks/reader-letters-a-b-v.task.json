{
  "schemaVersion": 1,
  "id": "reader-letters-a-b-v",
  "version": 1,
  "title": "Привет, строчник!",
  "summary": "Подавайте импульсы А, Б и В при появлении соответствующих букв во входной строке.",
  "codeWord": "АЛФАВИТ",
  "descriptionFile": "reader-letters-a-b-v.md",
  "platformId": "junior-reader",
  "tests": [
    {
      "id": "example",
      "title": "Пример из условия",
      "timeoutSeconds": 10,
      "input": { "message": "ВАББГ" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseC", "impulseA", "impulseB", "impulseB"]
        }
      ]
    },
    {
      "id": "mixed-letters",
      "title": "Порядок сигналов",
      "timeoutSeconds": 10,
      "input": { "message": "АВБАВБ" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseA", "impulseC", "impulseB", "impulseA", "impulseC", "impulseB"]
        }
      ]
    },
    {
      "id": "ignored-letters",
      "title": "Остальные буквы",
      "timeoutSeconds": 10,
      "input": { "message": "ГДЕЖ" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": []
        }
      ]
    }
  ]
}
