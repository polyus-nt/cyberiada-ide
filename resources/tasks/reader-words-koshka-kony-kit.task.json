{
  "schemaVersion": 1,
  "id": "reader-words-koshka-kony-kit",
  "version": 1,
  "title": "Строчник и слова",
  "summary": "Распознавайте в строке слова КОШКА, КОНЬ и КИТ и подавайте соответствующие импульсы.",
  "codeWord": "ЗВЕРИНЕЦ",
  "descriptionFile": "reader-words-koshka-kony-kit.md",
  "platformId": "junior-reader",
  "tests": [
    {
      "id": "example",
      "title": "Пример из условия",
      "timeoutSeconds": 10,
      "input": { "message": "КОШКАКОНЬКИТКОНЬ" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseA", "impulseB", "impulseC", "impulseB"]
        }
      ]
    },
    {
      "id": "different-order",
      "title": "Слова в другом порядке",
      "timeoutSeconds": 10,
      "input": { "message": "КИТКОШКАКОНЬ" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseC", "impulseA", "impulseB"]
        }
      ]
    },
    {
      "id": "repeated-words",
      "title": "Повторные вхождения",
      "timeoutSeconds": 10,
      "input": { "message": "КОШКАКОШКАКИТКИТ" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseA", "impulseA", "impulseC", "impulseC"]
        }
      ]
    },
    {
      "id": "restart-after-partial-match",
      "title": "Новое слово после неполного совпадения",
      "timeoutSeconds": 10,
      "input": { "message": "КОКОНЬКИКОШКА" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": ["impulseB", "impulseA"]
        }
      ]
    },
    {
      "id": "no-complete-words",
      "title": "Неполные слова и посторонние буквы",
      "timeoutSeconds": 10,
      "input": { "message": "АБВКОШККОНКИКА" },
      "checks": [
        {
          "type": "reader.impulses.equals",
          "expected": []
        }
      ]
    }
  ]
}
